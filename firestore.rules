rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accessDoc() { return get(/databases/$(database)/documents/access/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && accessDoc().data.role == 'admin'; }
    function canUse(userId) {
      return signedIn() && (isAdmin() || userId in accessDoc().data.learnerIds);
    }
    function validLearnerPlanSettings() {
      return request.resource.data.keys().hasAll(['budgetMinutes', 'grade', 'semester', 'scopes', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['budgetMinutes', 'grade', 'semester', 'englishActivity', 'scopes', 'publisher', 'weekly', 'updatedAt', 'updatedBy'])
        && (!request.resource.data.keys().hasAny(['weekly']) || validWeekly(request.resource.data.weekly))
        && request.resource.data.budgetMinutes in [30, 45, 60]
        && request.resource.data.grade is int
        && request.resource.data.grade >= 1
        && request.resource.data.grade <= 12
        && request.resource.data.semester in [1, 2]
        && (!request.resource.data.keys().hasAny(['englishActivity']) || request.resource.data.englishActivity in ['vocabulary', 'reading'])
        && (!request.resource.data.keys().hasAny(['publisher'])
          || (request.resource.data.publisher is string && request.resource.data.publisher.size() <= 80))
        && request.resource.data.scopes is map
        && request.resource.data.scopes.keys().hasAll(['reading', 'english', 'math'])
        && request.resource.data.scopes.keys().hasOnly(['reading', 'korean_vocab', 'english', 'english_reading', 'math'])
        && validScope(request.resource.data.scopes.reading, 'reading')
        && validScope(request.resource.data.scopes.english, 'english')
        && (!request.resource.data.scopes.keys().hasAny(['english_reading']) || validScope(request.resource.data.scopes.english_reading, 'english_reading'))
        && (!request.resource.data.scopes.keys().hasAny(['korean_vocab']) || validScope(request.resource.data.scopes.korean_vocab, 'korean_vocab'))
        && validScope(request.resource.data.scopes.math, 'math')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function validId(value) {
      return value is string && value.size() > 0 && value.size() <= 80 && value.matches('^[A-Za-z0-9_-]+$');
    }
    function validWeekly(w) {
      return w is map && w.keys().hasAll(['learningDays','miniCheck','mockSectionMinutes'])
        && w.keys().hasOnly(['learningDays','miniCheck','mockSectionMinutes'])
        && w.learningDays in [5,6] && w.miniCheck is bool
        && w.mockSectionMinutes is map
        && w.mockSectionMinutes.keys().hasAll(['reading','english','math','hanja'])
        && w.mockSectionMinutes.keys().hasOnly(['reading','english','math','hanja'])
        && w.mockSectionMinutes.reading is int && w.mockSectionMinutes.reading >= 5 && w.mockSectionMinutes.reading <= 60
        && w.mockSectionMinutes.english is int && w.mockSectionMinutes.english >= 5 && w.mockSectionMinutes.english <= 60
        && w.mockSectionMinutes.math is int && w.mockSectionMinutes.math >= 5 && w.mockSectionMinutes.math <= 60
        && w.mockSectionMinutes.hanja is int && w.mockSectionMinutes.hanja >= 5 && w.mockSectionMinutes.hanja <= 60;
    }
    function validEnglishReadingScope(scope) {
      return (scope.levelId == 'grade6' && scope.unitId in ['er1','er2','er3','er4','er5','er6'])
        || (scope.levelId == 'middle1' && scope.unitId.matches('^mr1-unit[12]$'))
        || (scope.levelId == 'middle2' && scope.unitId.matches('^mr2-unit[12]$'))
        || (scope.levelId == 'middle3' && scope.unitId.matches('^mr3-unit[12]$'))
        || (scope.levelId == 'high1' && scope.unitId.matches('^hr1-unit[12]$'))
        || (scope.levelId == 'high2' && scope.unitId.matches('^hr2-unit[12]$'))
        || (scope.levelId == 'high3' && scope.unitId.matches('^hr3-unit[12]$'));
    }
    function validScope(scope, subject) {
      return scope is map
        && scope.keys().hasAll(['mode'])
        && scope.keys().hasOnly(['mode', 'levelId', 'semesterId', 'unitId'])
        && scope.mode in ['auto', 'assigned']
        && ((scope.mode == 'auto' && scope.keys().hasOnly(['mode']))
          || (scope.mode == 'assigned'
            && validId(scope.unitId)
            && ((subject == 'reading' && scope.keys().hasAll(['mode', 'levelId', 'unitId']) && scope.keys().hasOnly(['mode', 'levelId', 'unitId']) && validId(scope.levelId))
              || (subject == 'english' && scope.keys().hasAll(['mode', 'unitId']) && scope.keys().hasOnly(['mode', 'unitId']))
              || (subject == 'korean_vocab' && scope.keys().hasAll(['mode', 'levelId', 'unitId']) && scope.keys().hasOnly(['mode', 'levelId', 'unitId']) && scope.levelId in ['level1', 'level2'])
              || (subject == 'english_reading' && scope.keys().hasAll(['mode', 'levelId', 'unitId']) && scope.keys().hasOnly(['mode', 'levelId', 'unitId']) && validEnglishReadingScope(scope))
              || (subject == 'math' && scope.keys().hasAll(['mode', 'levelId', 'semesterId', 'unitId']) && scope.keys().hasOnly(['mode', 'levelId', 'semesterId', 'unitId']) && validId(scope.levelId) && scope.semesterId in ['1', '2']))));
    }
    // A parent-printed exam occupies one weekly round (1-3) with its 55 questions; it has no answers or scores.
    function validPaperMock(p) {
      return p.status == 'paper' && p.mode == 'paper'
        && p.attemptNo is int && p.attemptNo >= 1 && p.attemptNo <= 3
        && p.assessmentId.matches('^mock:.+:[0-9]{4}-[0-9]{2}-[0-9]{2}:attempt-[1-3]-paper-[A-Za-z0-9-]+$')
        && p.questions is list && p.questions.size() == 55
        && !p.keys().hasAny(['submittedAt', 'initialAttempts', 'reports', 'responses']);
    }
    // The parent's OMR scoring of that printed round: a submitted result checked like an online
    // submission, keeping the round's assessmentId, attemptNo, week and questions.
    function validPaperResult(p, old) {
      return p.status == 'submitted' && p.mode == 'paper' && p.kind == 'mock'
        && p.assessmentId == old.assessmentId && p.userId == old.userId
        && p.scheduledWeekId == old.scheduledWeekId && p.attemptNo == old.attemptNo
        && p.questions == old.questions
        && p.integrity is map && p.integrity.source == 'paper-omr'
        && p.submittedAt is int
        && p.sections is list && p.sections.size() == 4
        && p.sections[0].id == 'reading' && p.sections[0].state == 'ended'
        && p.sections[1].id == 'english' && p.sections[1].state == 'ended'
        && p.sections[2].id == 'math' && p.sections[2].state == 'ended'
        && p.sections[3].id == 'hanja' && p.sections[3].state == 'ended'
        && p.initialAttempts is list && p.initialAttempts.size() == 55
        && p.reports is list && p.reports.size() >= 4 && p.reports.size() <= 8;
    }
    function validStudyRequest(userId) {
      return request.resource.data.keys().hasAll(['learnerId', 'requestId', 'requestedAt', 'requestedBy', 'status'])
        && request.resource.data.keys().hasOnly(['learnerId', 'requestId', 'requestedAt', 'requestedBy', 'status', 'startedAt', 'startedBy'])
        && request.resource.data.learnerId == userId
        && validId(request.resource.data.requestId)
        && request.resource.data.requestedBy == request.auth.uid;
    }
    function validActivity(userId) {
      return request.resource.data.keys().hasAll(['learnerId', 'activityId', 'source', 'occurredAt', 'startedAt', 'startedBy'])
        && request.resource.data.keys().hasOnly(['learnerId', 'activityId', 'source', 'subject', 'occurredAt', 'startedAt', 'startedBy'])
        && request.resource.data.learnerId == userId
        && validId(request.resource.data.activityId)
        && request.resource.data.source is string && request.resource.data.source.size() > 0 && request.resource.data.source.size() <= 40
        && (!request.resource.data.keys().hasAny(['subject']) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 40))
        && request.resource.data.occurredAt is timestamp && request.resource.data.occurredAt <= request.time + duration.value(5, 'm')
        && request.resource.data.startedAt == request.time && request.resource.data.startedBy == request.auth.uid;
    }

    match /access/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /learnerPlanSettings/{userId} {
      allow get: if canUse(userId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validLearnerPlanSettings();
      allow delete: if false;
    }
    match /learnerStudyRequests/{userId} {
      allow get: if canUse(userId);
      allow list, delete: if false;
      allow create: if isAdmin() && validStudyRequest(userId)
        && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time
        && !request.resource.data.keys().hasAny(['startedAt', 'startedBy']);
      allow update: if (isAdmin() && validStudyRequest(userId)
          && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time
          && request.resource.data.requestId != resource.data.requestId
          && request.time >= resource.data.requestedAt + duration.value(60, 's')
          && !request.resource.data.keys().hasAny(['startedAt', 'startedBy']))
        || (canUse(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt', 'startedBy'])
          && resource.data.status == 'pending' && request.resource.data.status == 'started'
          && request.resource.data.startedAt == request.time && request.resource.data.startedBy == request.auth.uid);
    }
    match /learnerActivity/{userId} {
      allow get: if canUse(userId);
      allow list, delete: if false;
      allow create, update: if canUse(userId) && validActivity(userId);
    }
    match /notificationDevices/{deviceId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.role in ['learner', 'guardian']
        && ((request.resource.data.role == 'learner' && canUse(request.resource.data.learnerId))
          || (request.resource.data.role == 'guardian' && isAdmin()));
      allow update: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.role in ['learner', 'guardian']
        && ((request.resource.data.role == 'learner' && canUse(request.resource.data.learnerId))
          || (request.resource.data.role == 'guardian' && isAdmin()));
      allow delete: if signedIn() && (resource.data.authUid == request.auth.uid || isAdmin());
      allow read: if signedIn() && (resource.data.authUid == request.auth.uid || isAdmin());
    }
    match /notificationEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && canUse(request.resource.data.learnerId)
        && request.resource.data.type in ['study_started', 'quiz_completed'];
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /notificationDeliveries/{deliveryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /mockExamResults/{examId} {
      allow get: if signedIn() && resource == null;
      allow read: if canUse(resource.data.learnerId);
      allow create: if canUse(request.resource.data.learnerId)
        && examId == request.resource.data.learnerId + '|' + request.resource.data.assessmentId
        && request.resource.data.keys().hasAll(['learnerId','assessmentId','payload','published','publishedAt','publishedBy','createdBy','createdAt'])
        && request.resource.data.keys().hasOnly(['learnerId','assessmentId','payload','published','publishedAt','publishedBy','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.published == false && request.resource.data.publishedAt == null && request.resource.data.publishedBy == null
        && request.resource.data.payload.assessmentId == request.resource.data.assessmentId
        && request.resource.data.payload.userId == request.resource.data.learnerId
        && request.resource.data.payload.kind == 'mock'
        && request.resource.data.payload.scheduledWeekId is string
        && request.resource.data.payload.scheduledWeekId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // A parent-printed paper round (admin only) instead of a submitted online exam.
        && ((isAdmin() && validPaperMock(request.resource.data.payload))
        || (request.resource.data.payload.status == 'submitted'
        && request.resource.data.payload.sections is list && request.resource.data.payload.sections.size() == 4
        && request.resource.data.payload.sections[0].id == 'reading' && request.resource.data.payload.sections[0].state == 'ended'
        && request.resource.data.payload.sections[1].id == 'english' && request.resource.data.payload.sections[1].state == 'ended'
        && request.resource.data.payload.sections[2].id == 'math' && request.resource.data.payload.sections[2].state == 'ended'
        && request.resource.data.payload.sections[3].id == 'hanja' && request.resource.data.payload.sections[3].state == 'ended'
        && request.resource.data.payload.questions is list && request.resource.data.payload.initialAttempts is list && request.resource.data.payload.reports is list
        && request.resource.data.payload.questions.size() == 55
        && request.resource.data.payload.initialAttempts.size() == 55
        // Four areas, with only the studied component subjects represented (up to eight).
        && request.resource.data.payload.reports.size() >= 4
        && request.resource.data.payload.reports.size() <= 8));
      // Paper rounds have no score to publish.
      allow update: if isAdmin() && canUse(resource.data.learnerId)
        && resource.data.payload.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published','publishedAt','publishedBy'])
        && resource.data.published == false && request.resource.data.published == true
        && request.resource.data.publishedBy == request.auth.uid && request.resource.data.publishedAt == request.time;
      // OMR scoring (admin only): one transition from a printed round to its submitted result.
      // Only the payload changes, publication stays false, and a scored round is not paper any more.
      allow update: if isAdmin() && canUse(resource.data.learnerId)
        && validPaperMock(resource.data.payload) && resource.data.published == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload'])
        && validPaperResult(request.resource.data.payload, resource.data.payload);
      allow delete: if false;
    }
    match /users/{userId} {
      allow get, create, update: if canUse(userId);
      allow list, delete: if isAdmin();
      match /{document=**} { allow read, write: if canUse(userId); }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
