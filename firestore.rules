rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accessDoc() { return get(/databases/$(database)/documents/access/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && accessDoc().data.role == 'admin'; }
    function canUse(userId) {
      return signedIn() && (isAdmin() || userId in accessDoc().data.learnerIds);
    }
    function validLearnerPlanSettings() {
      return request.resource.data.keys().hasAll(['budgetMinutes', 'grade', 'semester', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['budgetMinutes', 'grade', 'semester', 'publisher', 'updatedAt', 'updatedBy'])
        && request.resource.data.budgetMinutes in [30, 45, 60]
        && request.resource.data.grade is int
        && request.resource.data.grade >= 1
        && request.resource.data.grade <= 12
        && request.resource.data.semester in [1, 2]
        && (!request.resource.data.keys().hasAny(['publisher'])
          || (request.resource.data.publisher is string && request.resource.data.publisher.size() <= 80))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /access/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /learnerPlanSettings/{userId} {
      allow get: if canUse(userId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validLearnerPlanSettings();
      allow delete: if false;
    }
    match /notificationDevices/{deviceId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.role in ['learner', 'guardian']
        && ((request.resource.data.role == 'learner' && canUse(request.resource.data.learnerId))
          || (request.resource.data.role == 'guardian' && isAdmin()));
      allow update: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.role in ['learner', 'guardian']
        && ((request.resource.data.role == 'learner' && canUse(request.resource.data.learnerId))
          || (request.resource.data.role == 'guardian' && isAdmin()));
      allow delete: if signedIn() && (resource.data.authUid == request.auth.uid || isAdmin());
      allow read: if signedIn() && (resource.data.authUid == request.auth.uid || isAdmin());
    }
    match /notificationEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && canUse(request.resource.data.learnerId)
        && request.resource.data.type in ['study_started', 'quiz_completed'];
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /notificationDeliveries/{deliveryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /users/{userId} {
      allow get, create, update: if canUse(userId);
      allow list, delete: if isAdmin();
      match /{document=**} { allow read, write: if canUse(userId); }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
